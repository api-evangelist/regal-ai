{
  "opencollection": "1.0.0",
  "info": {
    "name": "Regal Branded Phone Numbers Campaigns API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Campaigns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Campaigns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.regal.ai/v1/campaigns"
          },
          "docs": "List outbound campaigns configured in the tenant."
        }
      ]
    }
  ],
  "bundled": true
}